# Copy to .env and adjust. All values are optional; defaults shown.

# Root used to resolve the paths below (defaults to the repository root)
SMARTCITY_HOME=.

# SMARTCITY_DATA_DIR=./dataset
# SMARTCITY_DB=./var/smartcity.db
# SMARTCITY_MODEL_DIR=./var/models
# SMARTCITY_REPORT_DIR=./var/reports
# SMARTCITY_FIGURE_DIR=./docs/figures

# Comma-separated list of origins allowed to call the API from a browser
SMARTCITY_CORS_ORIGINS=http://localhost:5173

# Require this value in an X-API-Key header on every endpoint except /health (unset = open)
# SMARTCITY_API_KEY=change-me
# POST requests per minute per client address, 0 disables
# SMARTCITY_RATE_LIMIT=60
# Set to 1 behind a reverse proxy so client addresses come from X-Forwarded-For
# SMARTCITY_TRUST_PROXY=1
